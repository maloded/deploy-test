    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
