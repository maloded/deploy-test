# Names only, no values. Copy to .env.local (git-ignored) and fill in what you need.
# Where the products live (default ./content; a relative value is resolved from the project root).
CONTENT_DIR=
# Which product to show, as <seller>/<product> (default: the only product in the content root). Replaces CONTENT_SLUG.
CONTENT_PRODUCT=
# Review demo (see DEPLOY.md)
REVIEW_THEME_SWITCHER=
NEXT_PUBLIC_PROTOTYPE_NOTE=
# Contact form leads (see PROJECT.md "Lead handling"). LEADS_STORE is "file", "webhook" or "telegram"; with none set the API answers 503.
LEADS_STORE=
# file store: folder for the lead files (default ./data/leads, git-ignored; a read-only host cannot use it)
LEADS_DIR=
# webhook store: an https URL that receives each lead as JSON
LEADS_WEBHOOK_URL=
# Telegram delivery (see docs/LEADS.md). LEADS_STORE=telegram delivers the lead to the chat (no database); LEADS_NOTIFY=telegram tells the chat AFTER another store accepted the lead. Not both.
LEADS_NOTIFY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "full" (with contact data; default for the store) or "short" (no personal data; default for the notifier)
TELEGRAM_DETAIL=
