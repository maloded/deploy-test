# .env.example: the documented template for .env.local
#
#   cp .env.example .env.local     (.env.local is git-ignored: never commit it, never paste its values anywhere)
#
# Every value below is a SAFE PLACEHOLDER, not a real token, chat id, address or URL. Everything except the two content
# variables is commented out: uncomment a line only when you need it and replace the placeholder.
# A variable already set in the shell wins over this file. On Vercel the same names go into Project Settings ->
# Environment Variables (Production only for secrets and SITE_*; mark secrets "Sensitive").
#
# Legend used in the comments:
#   required   : needed for the feature to work / "optional" otherwise
#   build time : read by `next build` and inlined; a change needs a new build (on a host: a new deployment)
#   run time   : read by the running server on every request; a restart is enough
#   secret     : never commit, never prefix with NEXT_PUBLIC_, set as a Sensitive variable on the host
#   demo / production : which kind of site uses it (see README "Demo vs release mode")

# ======================================================================================================================
# 1. Content: where the seller and product data live
# ======================================================================================================================

# CONTENT_DIR: the content root, the folder that holds <seller>/seller.json and <seller>/<product>/product.json.
# What it does:  tells every script and the build where the content is (a deploy repo keeps it in ./content).
# Required:      locally yes (without it and without ./content the build stops on purpose); on a deploy repo LEAVE UNSET.
# Time:          build time (also read by images, snapshot, verify:deploy, the checks).
# Secret:        no. Demo and production: both.
# Format:        a path; relative values are resolved from the project root, absolute paths are used as they are.
# Where from:    the folder of your content repository (for example ../my-content-repo), or `examples` for the fake samples.
CONTENT_DIR=examples

# CONTENT_PRODUCT: which product the site shows.
# What it does:  picks one product when the content root has several; the page, the lead API and verify:deploy use it.
# Required:      only when the content root holds more than one product (otherwise the only product is used).
# Time:          build time (also read by the scripts). Secret: no. Demo and production: both.
# Format:        <seller>/<product>, lowercase letters, digits and dashes, for example example-seller/example-house.
# Where from:    the two folder names under the content root. The old CONTENT_SLUG is refused: rename it to this.
CONTENT_PRODUCT=example-seller/example-house

# ======================================================================================================================
# 2. Site and indexing (a public release; leave all of it unset for a demo)
# ======================================================================================================================

# SITE_INDEXABLE: allow search engines.
# What it does:  with 1, robots.txt allows crawling, the noindex tags and header go away and /sitemap.xml is served.
#                Unset (the default) keeps EVERYTHING noindex. The 404 and error pages stay noindex either way.
# Required:      no (release only). Time: build time. Secret: no.
# Production:    set for the Production environment ONLY, so preview URLs stay noindex.
# Values:        1 (anything else counts as unset).
# SITE_INDEXABLE=1

# SITE_URL: the site's public address.
# What it does:  becomes metadataBase: absolute canonical, hreflang, Open Graph URLs and the sitemap.
# Required:      YES when SITE_INDEXABLE=1 (the build stops with a message without it); otherwise optional.
# Time:          build time. Secret: no. Production only.
# Format:        an https origin, no path, query or trailing slash: https://www.example.com
#                (http:// is accepted only for localhost tests).
# Where from:    the domain you attach to the host project.
# SITE_URL=https://www.example.com

# ======================================================================================================================
# 3. Demo / review flags (a review deployment; never set them for a release)
# ======================================================================================================================

# NEXT_PUBLIC_PROTOTYPE_NOTE: mark the site as a prototype.
# What it does:  shows the footer line "Prototype. Content is a draft ...", a note next to the contact dialog's send
#                button, and turns on /version.json (version, template and content commit, build time).
# Required:      no. Time: build time (NEXT_PUBLIC_ means it is visible in the browser: it holds no secret). Demo only.
# Values:        any non-empty value, normally 1. Leave unset for a release (verify:deploy --release checks it).
# NEXT_PUBLIC_PROTOTYPE_NOTE=1

# REVIEW_THEME_SWITCHER: let a reviewer compare themes in production.
# What it does:  shows the small theme switcher in a production build (in `npm run dev` it is always there).
#                It also makes pages render per request instead of static; one observed deployment then failed to
#                find its images (see DEPLOY.md), so prefer not to set it on a host.
# Required:      no. Time: build time. Secret: no. Demo only, NEVER for a release.
# Values:        1 (anything else counts as unset).
# REVIEW_THEME_SWITCHER=1

# ======================================================================================================================
# 4. Leads: where the contact form's requests go (see docs/LEADS.md)
# ======================================================================================================================
# All lead variables are read at RUN time. With no working store the API answers 503 and the form shows the seller's
# e-mail address instead of claiming success. Demo and production: both.

# LEADS_STORE: where a request is delivered.
# Required:      for a working contact form. Time: run time. Secret: no.
# Values:        telegram | webhook | file | none. "none" means leave it unset or empty: the API answers 503 (the
#                literal text none is also refused, but logs an "unknown LEADS_STORE" line).
#                telegram needs a Vercel-friendly bot + chat (no database); webhook needs a receiver you run;
#                file writes JSON files and cannot work on a read-only host such as Vercel.
# LEADS_STORE=telegram

# LEADS_NOTIFY: also tell a Telegram chat AFTER another store accepted the lead.
# Required:      no. Time: run time. Secret: no.
# Values:        telegram (or unset). Not together with LEADS_STORE=telegram (a configuration error: it would arrive twice).
#                A notifier alone is not a store.
# LEADS_NOTIFY=telegram

# TELEGRAM_BOT_TOKEN: the bot that sends the message.
# Required:      when LEADS_STORE or LEADS_NOTIFY is telegram. Time: run time. SECRET (Sensitive on the host).
# Format:        <digits>:<secret>, for example 123456789:replace-with-the-token-from-botfather-xxxxxxx
# Where from:    open @BotFather in Telegram, send /newbot, copy the token. Lost or leaked: /revoke there.
# TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-botfather-xxxxxxx

# TELEGRAM_CHAT_ID: the chat that receives the messages.
# Required:      when LEADS_STORE or LEADS_NOTIFY is telegram. Time: run time. Secret: no, but private (do not publish).
# Format:        a numeric id (negative for groups and channels, for example -1001234567890) or a public @channelname.
# Where from:    add the bot to the group, send /start@<botname> in it, then run `npm run telegram:chats` (it lists the
#                ids of the chats the bot has seen, never message texts). `npm run telegram:test` sends a test message.
# TELEGRAM_CHAT_ID=-1001234567890

# TELEGRAM_DETAIL: how much of the request goes to Telegram.
# Required:      no. Time: run time. Secret: no.
# Values:        full (with contact data) | short (no personal data). Default: full when Telegram is the store, short
#                when it is the notifier. Telegram as the ONLY store with short is refused. Telegram processes data
#                outside the EU: use short for real visitors where you can.
# TELEGRAM_DETAIL=short

# LEADS_WEBHOOK_URL: receiver of the webhook store.
# Required:      when LEADS_STORE=webhook. Time: run time. SECRET (treat the URL like a password).
# Format:        an https:// URL (http:// is accepted by the code but sends visitor data unencrypted) that answers 2xx
#                within 5 seconds, without redirects; it gets each lead as JSON (POST).
# Where from:    the service you run to receive leads.
# LEADS_WEBHOOK_URL=https://hooks.example.com/replace-with-your-receiver

# LEADS_DIR: folder of the file store.
# Required:      no, and only with LEADS_STORE=file. Time: run time. Secret: no (the files hold visitor data).
# Format:        a writable folder path; default ./data/leads (git-ignored, refused by the snapshot guard).
#                Not usable on a read-only host (Vercel).
# LEADS_DIR=./data/leads
